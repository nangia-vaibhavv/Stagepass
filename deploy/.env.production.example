# Copy this to deploy/.env.production on the server. Never commit the real file.
STAGEPASS_DOMAIN=your-subdomain.duckdns.org
CORS_ALLOWED_ORIGINS=https://your-project.vercel.app
DISABLE_DEMO_ADMIN=true
POSTGRES_DB=stagepass
POSTGRES_USER=stagepass
POSTGRES_PASSWORD=replace-with-a-long-random-hex-secret
POSTGRES_URL=postgres://stagepass:replace-with-a-long-random-hex-secret@postgres:5432/stagepass
JWT_SECRET=replace-with-at-least-64-random-hex-characters
PAYMENT_SERVICE_TOKEN=replace-with-a-long-random-secret
